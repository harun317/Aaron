        "\n",
        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.tree import DecisionTreeClassifier, export_text, export_graphviz, plot_tree\n",
        "\n",
        "raw_data = {\n",
        "    'Student_ID': [1001, 1002, 1003, 1004, 1005, 1001, 1006, 1007, 1008, 1009],\n",
        "    'County': ['Nakuru', 'Narok', 'Nakuru', 'Narok', 'Kakamega',\n",
        "               'Nakuru', 'Nairobi', None, 'Narok', 'Nakuru'],\n",
        "    'Study_Hours_Per_Week': [15, 8, 20, None, 12, 15, 30, 10, 25, 18],\n",
        "    'Attendance_Percent': [85, 60, 92, 55, 78, 85, 95, 65, 88, None],\n",
        "    'Fee_Balance_Ksh': [0, 15000, 0, 25000, 5000, 0, 0, 18000, 2000, 12000],\n",
        "    'Previous_Grade': [72, 48, 85, 45, 65, 72, 90, 50, 82, 58],\n",
        "    'Student_Type': ['Regular', 'Regular', 'Scholarship', 'Regular',\n",
        "                     'Scholarship', 'Regular', 'Regular', 'Scholarship',\n",
        "                     'Regular', 'Regular'],\n",
        "    'Academic_Risk': [0, 1, 0, 1, 0, 0, 0, 1, 0, 1]\n",
        "}\n",
        "df = pd.DataFrame(raw_data)\n",
        "\n",
        "pd.set_option('display.max_columns', None)\n",
        "print(\"Shape:\", df.shape)\n",
        "print(\"\\nData types:\\n\", df.dtypes)\n",
        "print(\"\\nSummary statistics:\\n\", df.describe())\n",
        "\n",
        "print(\"\\nMissing values:\\n\", df.isnull().sum())\n",
        "print(\"\\nDuplicate rows:\", df.duplicated().sum())\n",
        "\n",
        "\n",
        "df = df.drop_duplicates().reset_index(drop=True)\n",
        "\n",
        "\n",
        "df['County'] = df['County'].fillna(df['County'].mode()[0])\n",
        "\n",
        "df['Study_Hours_Per_Week'] = df['Study_Hours_Per_Week'].fillna(df['Study_Hours_Per_Week'].median())\n",
        "df['Attendance_Percent'] = df['Attendance_Percent'].fillna(df['Attendance_Percent'].median())\n",
        "\n",
        "print(\"\\nAfter cleaning -> shape:\", df.shape, \"| missing:\", df.isnull().sum().sum())\n",
        "\n",
        "num_cols = ['Study_Hours_Per_Week', 'Attendance_Percent', 'Fee_Balance_Ksh', 'Previous_Grade']\n",
        "\n",
        "print(\"\\nMeans by risk group:\\n\", df.groupby('Academic_Risk')[num_cols].mean().round(1))\n",
        "print(\"\\nCounty vs risk:\\n\", pd.crosstab(df['County'], df['Academic_Risk']))\n",
        "\n",
        "sns.set_style('whitegrid')\n",
        "fig, axes = plt.subplots(2, 3, figsize=(15, 8))\n",
        "for ax, col in zip(axes.flat[:4], num_cols):\n",
        "    sns.boxplot(data=df, x='Academic_Risk', y=col, ax=ax)\n",
        "    ax.set_title(f'{col} by Academic Risk')\n",
        "sns.countplot(data=df, x='County', hue='Academic_Risk', ax=axes.flat[4])\n",
        "axes.flat[4].set_title('County vs Academic Risk')\n",
        "sns.scatterplot(data=df, x='Attendance_Percent', y='Previous_Grade',\n",
        "                hue='Academic_Risk', s=90, ax=axes.flat[5])\n",
        "axes.flat[5].set_title('Attendance vs Previous Grade')\n",
        "plt.tight_layout()\n",
        "plt.savefig('eda_plots.png', dpi=150)\n",
        "plt.show()\n",
        "\n",
        "df['Attendance_Category'] = pd.cut(df['Attendance_Percent'],\n",
        "                                   bins=[0, 70, 85, 100],\n",
        "                                   labels=['Low', 'Medium', 'High'])\n",
        "df['Has_Fee_Balance'] = (df['Fee_Balance_Ksh'] > 0).astype(int)\n",
        "\n",
        "print(\"\\nNew features:\\n\", df[['Attendance_Percent', 'Attendance_Category',\n",
        "                                'Fee_Balance_Ksh', 'Has_Fee_Balance']])\n",
        "\n",
        "df_enc = pd.get_dummies(df, columns=['County', 'Student_Type', 'Attendance_Category'],\n",
        "                        dtype=int)\n",
        "\n",
        "scaler = StandardScaler()\n",
        "df_enc[num_cols] = scaler.fit_transform(df_enc[num_cols])\n",
        "print(\"\\nEncoded + standardized data:\\n\", df_enc.round(2))\n",
        "\n",
        "corr_cols = num_cols + ['Has_Fee_Balance', 'Academic_Risk']\n",
        "corr = df[corr_cols].corr()\n",
        "plt.figure(figsize=(8, 6))\n",
        "sns.heatmap(corr, annot=True, cmap='coolwarm', fmt='.2f', vmin=-1, vmax=1)\n",
        "plt.title('Correlation Heatmap')\n",
        "plt.tight_layout()\n",
        "plt.savefig('correlation_heatmap.png', dpi=150)\n",
        "plt.show()\n",
        "print(\"\\nCorrelation with Academic_Risk:\\n\",\n",
        "      corr['Academic_Risk'].drop('Academic_Risk').sort_values())\n",
        "\n",
        "X = df_enc.drop(columns=['Student_ID', 'Academic_Risk'])\n",
        "y = df_enc['Academic_Risk']\n",
        "\n",
        "tree = DecisionTreeClassifier(max_depth=3, random_state=42)\n",
        "tree.fit(X, y)\n",
        "\n",
        "print(\"\\nTraining accuracy:\", tree.score(X, y))\n",
        "print(\"\\nDecision rules:\\n\", export_text(tree, feature_names=list(X.columns)))\n",
        "print(\"Root feature:\", X.columns[tree.tree_.feature[0]])\n",
        "\n",
        "\n",
        "export_graphviz(tree, out_file='tree.dot', feature_names=list(X.columns),\n",
        "                class_names=['Not At Risk', 'At Risk'], filled=True, rounded=True)\n",
        "\n",
        "try:\n",
        "    import graphviz\n",
        "    with open('tree.dot') as f:\n",
        "        graphviz.Source(f.read()).render('academic_risk_tree', format='png', cleanup=True)\n",
        "    print(\"Saved academic_risk_tree.png\")\n",
        "except Exception as e:\n",
        "\n",
        "    print(\"Graphviz not available, using plot_tree instead:\", e)\n",
        "    plt.figure(figsize=(10, 6))\n",
        "    plot_tree(tree, feature_names=list(X.columns),\n",
        "              class_names=['Not At Risk', 'At Risk'], filled=True, rounded=True)\n",
        "    plt.savefig('academic_risk_tree.png', dpi=150)\n",
        "    plt.show()\n"
      ]
    }
